<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fengkuanglaidian.app"
    android:versionCode="9"
    android:versionName="0.9.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- 閿佸睆鍏ㄥ睆鏉ョ數锛欰ndroid 14 璧烽渶鐢ㄦ埛鎵嬪姩鏀捐锛堝簲鐢ㄥ唴浼氬紩瀵硷級 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 閫氱煡鏉冮檺锛圓ndroid 13+锛? -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 闇囧姩 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 褰曞埗鑷繁鐨勮闊冲寘 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 绮剧‘寤舵椂瑙﹀彂 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 浜睆涓庝繚鎸佸敜閱? -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- 鏉ョ數鐣岄潰闇€瑕佽兘鐩栧湪閿佸睆涔嬩笂 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 鍓嶅彴鏈嶅姟锛氳寤惰繜鍒扮偣鏃跺彲浠ョ洿鎺ユ媺璧峰叏灞忕晫闈紝鑰屼笉鍙槸涓€涓€氱煡 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <permission
        android:name="com.fengkuanglaidian.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.fengkuanglaidian.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrazyCall" >
        <activity
            android:name="com.fengkuanglaidian.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CrazyCall" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 鏉ョ數椤碉細閿佸睆鍙 + 鐐逛寒灞忓箷 + 涓嶄粠鏈€杩戜换鍔″嚭鐜? -->
        <activity
            android:name="com.fengkuanglaidian.app.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CrazyCall.Call"
            android:turnScreenOn="true" /> <!-- 璋冭瘯鐢ㄥ埆鍚嶏細榛樿鍏抽棴锛岄渶瑕佹姄鐣岄潰鏃朵复鏃跺惎鐢? -->
        <activity-alias
            android:name="com.fengkuanglaidian.app.DebugIncoming"
            android:exported="true"
            android:targetActivity="com.fengkuanglaidian.app.IncomingCallActivity" />

        <!-- 閫氳瘽涓〉 -->
        <activity
            android:name="com.fengkuanglaidian.app.InCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CrazyCall.Call"
            android:turnScreenOn="true" />

        <activity-alias
            android:name="com.fengkuanglaidian.app.DebugInCall"
            android:exported="true"
            android:targetActivity="com.fengkuanglaidian.app.InCallActivity" />

        <!-- 瀹氭椂瑙﹀彂鐨勫亣鏉ョ數 -->
        <receiver
            android:name="com.fengkuanglaidian.app.CallAlarmReceiver"
            android:exported="false" />

        <!-- 寤惰繜鏈熼棿椹荤暀鍓嶅彴锛岄伩鍏嶅悗鍙板惎鍔?Activity 琚郴缁熸嫤鎴? -->
        <service
            android:name="com.fengkuanglaidian.app.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep the fake-call trigger alive until the scheduled time" />
        </service>

        <!-- 涓嬫媺蹇嵎寮€鍏筹細鐐逛竴涓嬬珛鍒绘潵鐢? -->
        <service
            android:name="com.fengkuanglaidian.app.QuickCallTileService"
            android:exported="true"
            android:icon="@drawable/ic_call_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.fengkuanglaidian.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>